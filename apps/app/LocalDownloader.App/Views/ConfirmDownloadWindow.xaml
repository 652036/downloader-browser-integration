<Window x:Class="LocalDownloader.App.Views.ConfirmDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Download"
        Height="260" Width="480"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="File name:" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                 Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Source:" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SourceDomain}" VerticalAlignment="Center" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Size:" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SizeDisplay}" VerticalAlignment="Center" Margin="0,0,0,8" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Save to:" VerticalAlignment="Center" Margin="0,0,8,8" />
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,8,8"
                 Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Row="3" Grid.Column="2" Content="Browse…" Padding="8,2" Margin="0,0,0,8"
                Command="{Binding BrowseSaveDirectoryCommand}" />

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Return to Browser" Padding="10,4" Margin="0,0,8,0" Command="{Binding ReturnToBrowserCommand}" />
            <Button Content="Cancel" Padding="10,4" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
            <Button Content="Start Download" Padding="10,4" IsDefault="True" Command="{Binding StartCommand}" />
        </StackPanel>
    </Grid>
</Window>
