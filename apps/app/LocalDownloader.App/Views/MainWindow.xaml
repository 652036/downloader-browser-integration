<Window x:Class="LocalDownloader.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local Downloader"
        Height="520" Width="900"
        Closing="OnClosing">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="NewUrlTextBox"
                     Width="360"
                     Margin="0,0,4,0"
                     VerticalContentAlignment="Center"
                     Text="{Binding NewTaskUrl, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="New Task" Padding="8,2" Margin="0,0,12,0" Command="{Binding CreateTaskFromUrlCommand}" />
            <Button Content="Pause" Padding="8,2" Margin="0,0,4,0" Command="{Binding PauseSelectedCommand}" />
            <Button Content="Resume" Padding="8,2" Margin="0,0,4,0" Command="{Binding ResumeSelectedCommand}" />
            <Button Content="Cancel" Padding="8,2" Margin="0,0,4,0" Command="{Binding CancelSelectedCommand}" />
            <Button Content="Delete" Padding="8,2" Margin="0,0,12,0" Command="{Binding DeleteSelectedCommand}" />
            <Button Content="Open Folder" Padding="8,2" Margin="0,0,4,0" Command="{Binding OpenContainingFolderCommand}" />
            <Button Content="Settings" Padding="8,2" Click="OnSettingsClick" />
        </StackPanel>

        <DataGrid x:Name="TasksGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  ItemsSource="{Binding Tasks}"
                  SelectedItem="{Binding SelectedTask, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="*" />
                <DataGridTextColumn Header="Progress" Binding="{Binding ProgressDisplay}" Width="1.5*" />
                <DataGridTextColumn Header="Speed" Binding="{Binding SpeedDisplay}" Width="*" />
                <DataGridTextColumn Header="ETA" Binding="{Binding EtaDisplay}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="1.5*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
