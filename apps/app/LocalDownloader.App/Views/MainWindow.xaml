<Window x:Class="LocalDownloader.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本地下载器"
        Height="560" Width="920"
        MinHeight="360" MinWidth="640"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStyle="None"
        Closing="OnClosing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- 最大化时窗口会向外扩 7px，补 Padding 防止内容被裁剪 -->
    <Border x:Name="RootBorder">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左侧图标导航栏 ============ -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBgBrush}">
                <DockPanel Margin="0,48,0,8">
                    <Button DockPanel.Dock="Bottom"
                            Style="{StaticResource NavButton}"
                            Content="&#xE713;"
                            ToolTip="设置"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnSettingsClick" />
                    <StackPanel DockPanel.Dock="Top">
                        <Button Content="&#xE896;"
                                ToolTip="下载中"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding ShowActiveSectionCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSection}" Value="Active">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="&#xE930;"
                                ToolTip="已完成"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding ShowCompletedSectionCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSection}" Value="Completed">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ 右侧主区 ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 自绘标题栏 -->
                <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}">
                    <Grid>
                        <TextBlock Text="本地下载器"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource CaptionButton}"
                                    Content="&#xE921;"
                                    ToolTip="最小化"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="OnMinimizeClick" />
                            <Button x:Name="MaximizeButton"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="OnMaximizeRestoreClick">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                                        <Setter Property="Content" Value="&#xE922;" />
                                        <Setter Property="ToolTip" Value="最大化" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                <Setter Property="Content" Value="&#xE923;" />
                                                <Setter Property="ToolTip" Value="还原" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource CaptionCloseButton}"
                                    Content="&#xE8BB;"
                                    ToolTip="关闭"
                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                    Click="OnCloseClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 新建下载输入区 -->
                <Grid Grid.Row="1" Margin="16,14,16,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="NewUrlTextBox"
                             Style="{StaticResource PlaceholderTextBox}"
                             Tag="粘贴下载链接"
                             Text="{Binding NewTaskUrl, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding CreateTaskFromUrlCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="1"
                            Style="{StaticResource AccentButton}"
                            Margin="8,0,0,0"
                            Command="{Binding CreateTaskFromUrlCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="新建" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource IconButton}"
                            Margin="12,0,0,0"
                            Content="&#xE769;"
                            ToolTip="全部暂停"
                            Command="{Binding PauseAllCommand}" />
                    <Button Grid.Column="3"
                            Style="{StaticResource IconButton}"
                            Margin="4,0,0,0"
                            Content="&#xE768;"
                            ToolTip="全部开始"
                            Command="{Binding ResumeAllCommand}" />
                </Grid>

                <!-- 卡片式任务列表 -->
                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,8">
                        <ItemsControl x:Name="TaskList" ItemsSource="{Binding TasksView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="16,4,16,4" Padding="14,10,14,12" CornerRadius="6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource CardHoverBgBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- 第一行：类型图标 + 文件名 + 悬停操作 + 速度 -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding TypeGlyph}"
                                                           FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FileName}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />

                                                <!-- 悬停出现的操作按钮 -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <Button Style="{StaticResource IconButton}"
                                                            Content="&#xE769;"
                                                            ToolTip="暂停"
                                                            Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.PauseTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource IconButton}"
                                                            Content="&#xE768;"
                                                            ToolTip="继续"
                                                            Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.ResumeTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource IconButton}"
                                                            Content="&#xE838;"
                                                            ToolTip="打开所在文件夹"
                                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource DangerIconButton}"
                                                            Content="&#xE711;"
                                                            ToolTip="取消"
                                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource DangerIconButton}"
                                                            Content="&#xE74D;"
                                                            ToolTip="删除任务"
                                                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding SpeedDisplay}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- 第二行：细进度条 -->
                                            <ProgressBar Grid.Row="1"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding ProgressPercent, Mode=OneWay}">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>

                                            <!-- 第三行：元信息 -->
                                            <Grid Grid.Row="2" Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <StackPanel.Resources>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontSize" Value="11.5" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <Trigger Property="Text" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Resources>
                                                    <TextBlock Text="{Binding ProgressDisplay}" />
                                                    <TextBlock Text="{Binding EtaDisplay}" Margin="14,0,0,0" />
                                                    <TextBlock Text="{Binding SegmentDisplay}" Margin="14,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding StatusDisplay}"
                                                           FontSize="11.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="360">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态 -->
                    <TextBlock Text="暂无任务"
                               FontSize="13"
                               Foreground="{DynamicResource TextFaintBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=TaskList}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
