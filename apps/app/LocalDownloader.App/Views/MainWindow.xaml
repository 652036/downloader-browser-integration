<Window x:Class="LocalDownloader.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local Downloader"
        Height="480" Width="800"
        Closing="OnClosing">
    <Grid Margin="12">
        <DataGrid x:Name="TasksGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="*" />
                <DataGridTextColumn Header="Progress" Binding="{Binding ProgressDisplay}" Width="*" />
                <DataGridTextColumn Header="Speed" Binding="{Binding SpeedDisplay}" Width="*" />
                <DataGridTextColumn Header="ETA" Binding="{Binding EtaDisplay}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
