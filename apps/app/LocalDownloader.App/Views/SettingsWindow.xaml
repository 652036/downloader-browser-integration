<Window x:Class="LocalDownloader.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Height="500" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}">
            <Grid>
                <TextBlock Text="设置"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Style="{StaticResource CaptionCloseButton}"
                        Content="&#xE8BB;"
                        ToolTip="关闭"
                        HorizontalAlignment="Right"
                        Height="40"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnCloseClick" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="保存目录" VerticalAlignment="Center" Margin="0,0,12,10"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,10"
                     Text="{Binding DownloadDirectory, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Row="0" Grid.Column="2" Content="浏览…" Margin="0,0,0,10"
                    Command="{Binding BrowseDownloadDirectoryCommand}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="每任务连接数 (1-32)" VerticalAlignment="Center" Margin="0,0,12,10"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" HorizontalAlignment="Left" Width="80"
                     Text="{Binding ConnectionsPerTask, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="同时下载任务数" VerticalAlignment="Center" Margin="0,0,12,10"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10" HorizontalAlignment="Left" Width="80"
                     Text="{Binding MaxConcurrentTasks, UpdateSourceTrigger=PropertyChanged}" />

            <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Content="开机自启动" Margin="0,2,0,12"
                      IsChecked="{Binding LaunchAtStartup}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Text="拦截的文件类型（每行一个扩展名）" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     VerticalContentAlignment="Top"
                     Text="{Binding InterceptExtensionsText, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Margin="0,0,8,0" Command="{Binding CancelCommand}" />
                <Button Content="保存" Style="{StaticResource AccentButton}" IsDefault="True"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
